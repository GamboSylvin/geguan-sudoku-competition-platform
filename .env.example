# Sudoku Arena — environment template (Unit 01 foundation)
# Copy this file to `.env` and fill in real values. The real `.env` is git-ignored
# and must never be committed (code-standards.md, "Forbidden practices").
#
# Every variable the stack needs is listed here with a placeholder value.
# Versions are pinned by decision (BLD-016): Node.js LTS, PostgreSQL 16, Redis 7.

# ---------------------------------------------------------------------------
# Backend
# ---------------------------------------------------------------------------
NODE_ENV=development
BACKEND_PORT=3000
# Public origin the frontend is served from (used for links and CORS in later units).
FRONTEND_ORIGIN=http://localhost:5173

# The single server clock decides every timing question (architecture.md, Data flow).
# The timezone the server runs in; the round timer is server-owned, never client-owned.
TZ=Asia/Shanghai

# ---------------------------------------------------------------------------
# PostgreSQL 16 (durable data: results, setup, accounts, round state)
# ---------------------------------------------------------------------------
POSTGRES_USER=sudoku
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sudoku
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Prisma reads DATABASE_URL (the schema is the single source of truth, I-31).
DATABASE_URL=postgresql://sudoku:change-me@postgres:5432/sudoku?schema=public

# ---------------------------------------------------------------------------
# Redis 7 (runtime state: working grids; persistence turned on, BLD-007)
# ---------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# File storage (BLD-001: files live on the server's disk, in a mounted folder)
# Path template: {STORAGE_ROOT}/competitions/{competitionId}/{kind}/{fileId}-{originalName}
# ---------------------------------------------------------------------------
STORAGE_ROOT=/app/storage

# ---------------------------------------------------------------------------
# Frontend (Vite)
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:3000
