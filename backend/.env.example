# Backend environment variables — see the repository root `.env.example` for the
# full list and the comments. The real `.env` is git-ignored and never committed.
# In Docker Compose the values come from the root `.env`; this file documents the
# variables the backend itself reads.

NODE_ENV=development
BACKEND_PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
TZ=Asia/Shanghai

# PostgreSQL 16
DATABASE_URL=postgresql://sudoku:change-me@localhost:5432/sudoku?schema=public

# Redis 7 (persistence on)
REDIS_HOST=localhost
REDIS_PORT=6379

# File storage (BLD-001)
STORAGE_ROOT=./storage
