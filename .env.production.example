# Sudoku Arena — PRODUCTION environment template (BLD-048: single Alibaba Cloud ECS
# instance, Mainland China, reached by public IP, plain HTTP, no domain).
#
# On the server: copy this file to `.env` and fill in the real values.
#
#   cp .env.production.example .env
#   nano .env
#
# `.env` is git-ignored and must never be committed. THIS TEMPLATE holds no secrets
# and only ever holds obvious placeholders — if you find a real password in it, that
# is a mistake, delete it.
#
# `docker-compose.prod.yml` reads `.env` twice: once as the backend's `env_file`, and
# once for Compose's own `${...}` interpolation (the published port and the Postgres
# password). So a value set here reaches both the containers and Compose itself.
#
# THREE VALUES MUST BE CHANGED BEFORE THE FIRST START — they are marked with
# CHANGE_ME below and in DEPLOY.md:
#   1. POSTGRES_PASSWORD
#   2. the password inside DATABASE_URL (must match POSTGRES_PASSWORD exactly)
#   3. FRONTEND_ORIGIN (the server's real public IP)
# `docker-compose.prod.yml` refuses to start with the placeholder password still in
# place, so forgetting #1 fails loudly rather than deploying a guessable secret.

# ---------------------------------------------------------------------------
# Backend
# ---------------------------------------------------------------------------
NODE_ENV=production

# The port the Node server listens on INSIDE the container. Leave at 300; the
# public port is HTTP_PORT below.
BACKEND_PORT=3000

# CHANGE_ME (3 of 3): the origin the frontend is served from — i.e. THIS SERVER's
# public IP, filled in at deploy time. It is used for the CORS check and, more
# importantly, for the Socket.io handshake (`realtime/gateway.ts`), so a wrong value
# here breaks the live round timer and the live ranking on the big screen even though
# the pages themselves still load. Plain `http://` — there is no TLS yet (I-40), and
# no domain, so it is a bare IP (BLD-048). Example below, replace the numbers.
FRONTEND_ORIGIN=http://CHANGE_ME_SERVER_PUBLIC_IP

# The single server clock decides every timing question (architecture.md, Data flow);
# the round timer is server-owned, never client-owned. The ECS instance is in a
# Mainland China region and the event is in China, so Asia/Shanghai is correct.
TZ=Asia/Shanghai

# Session lifetime in hours, fixed from login and never refreshed (AUTH-001, I-16).
# 24 h covers a full event day; a session created the morning of the event does not
# expire mid-competition.
SESSION_TTL_HOURS=24

# ---------------------------------------------------------------------------
# PostgreSQL 16 (durable data: results, setup, accounts, round state)
# ---------------------------------------------------------------------------
POSTGRES_USER=sudoku
# CHANGE_ME (1 of 3): a real random password. Not `change-me`, not the placeholder
# below, not anything reused from another system. Generate one, e.g.:
#   openssl rand -base64 24
# The port is never published (`docker-compose.prod.yml` has no `ports:` on this
# service), so the database is reachable only from inside the Compose network — but
# the password still must not be guessable, because it also appears in DATABASE_URL.
POSTGRES_PASSWORD=CHANGE_ME_BEFORE_DEPLOY
POSTGRES_DB=sudoku
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# CHANGE_ME (2 of 3): Prisma reads this (I-31). It must contain the SAME user,
# password, host, port and database as the four variables above — a mismatch here is
# the classic "migrate works but the server cannot connect" failure, or the reverse.
DATABASE_URL=postgresql://sudoku:CHANGE_ME_BEFORE_DEPLOY@postgres:5432/sudoku?schema=public

# ---------------------------------------------------------------------------
# Redis 7 (runtime state: working grids; persistence on, BLD-007)
# ---------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# File storage (BLD-001: uploaded/exported files live on the server's disk, in the
# `storage-prod-data` named volume mounted at this path).
# Path template: {STORAGE_ROOT}/competitions/{competitionId}/{kind}/{fileId}-{originalName}
# ---------------------------------------------------------------------------
STORAGE_ROOT=/app/storage

# ---------------------------------------------------------------------------
# Where the backend finds the frontend's built bundle to serve it (same origin, one
# port — see DEPLOY.md, "How the frontend is served"). This is the path INSIDE the
# image, where `backend/Dockerfile.prod` copies the Vite build. Do not change it.
# ---------------------------------------------------------------------------
FRONTEND_DIST=/app/frontend-dist

# ---------------------------------------------------------------------------
# Compose-only (read by `docker-compose.prod.yml` for interpolation, not by the app)
# ---------------------------------------------------------------------------
# The port opened on the server's public interface. 80 means the browser needs no
# port number: http://<public-ip>/ . This is the ONLY port to open in the Alibaba
# Cloud security group.
HTTP_PORT=80

# ---------------------------------------------------------------------------
# Frontend (Vite) — BUILD-TIME only, read by `backend/Dockerfile.prod` as an ARG
# ---------------------------------------------------------------------------
# LEAVE THIS EMPTY. That is the whole point of the same-origin deployment: with an
# empty base URL every API call and every Socket.io connection is relative to the
# page's own origin, so the image works on any IP with no rebuild. Putting a URL here
# bakes an address into the bundle and reintroduces exactly the fragility this setup
# avoids.
VITE_API_BASE_URL=
