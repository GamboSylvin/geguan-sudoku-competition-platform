# folders
node_modules/
.claude/
.cowork-temp/
dist/
build/
coverage/
.nyc_output/

# environmental variables
.env
.env.*
!.env.example
# The production template is a template (no secrets), so it is tracked too (BLD-048).
!.env.production.example

# local file storage (BLD-001: files live on the server's disk, in a mounted folder)
storage/

# logs
*.log
npm-debug.log*

# editors / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Microsoft Office lock files (created while a file is open on someone's machine)
~$*

# AI agent hand-off notes (continuity files for switching AI platforms) — local only, never committed
AI-HANDOFF*.md

# The project owner's deployment memo, written in French — local only, same as the hand-off
# notes above; `DEPLOY.md` is the committed, English runbook it complements.
DEPLOY-CHECKLIST.md

# The AI build methodology reference — kept local, never part of the shipped repo.
building-with-ai/

# Scratch artifacts, not part of the project — crash dumps, ad-hoc .xlsx inspection files.
bash.exe.stackdump
.tmp-xlsx/

# Dated anomaly/findings reports written up from a manual test pass — working documents for
# the project owner and the coding side, not part of the deliverable (unlike
# testing/manual-test-scenarios.md, which stays tracked). The canonical copy of the client
# CSS reference report lives at context/design/RAPPORT-CSS-sudoku_arena.md; a root-level copy
# is a stray duplicate, not a second source of truth.
/RAPPORT-CSS-sudoku_arena.md
RAPPORT-TESTS-MANUELS-*.md
ANOMALY-REPORT-*.md
