# folders
node_modules/
.claude/
.cowork-temp/
dist/
build/
coverage/
.nyc_output/

# environmental variables
.env
.env.*
!.env.example
# The production template is a template (no secrets), so it is tracked too (BLD-048).
!.env.production.example

# local file storage (BLD-001: files live on the server's disk, in a mounted folder)
storage/

# logs
*.log
npm-debug.log*

# editors / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Microsoft Office lock files (created while a file is open on someone's machine)
~$*

# AI agent hand-off notes (continuity files for switching AI platforms) — local only, never committed
AI-HANDOFF*.md

# The project owner's French deployment aide-mémoire — local only, same as the hand-off notes
# above; `DEPLOY.md` is the committed, English runbook it complements.
DEPLOY-CHECKLIST.md
